<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/financial">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background"
        tools:context=".FinancialActivity">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingBottom="80dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="12dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="660dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/GoalText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Financial Report: Expense"
                            android:textAlignment="center"
                            android:textColor="@color/bright_orange"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <!-- Buttons Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <Button
                                android:id="@+id/addIncomeBtn"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/grey"
                                android:text="Income"
                                android:textColor="@color/black"
                                android:textSize="10sp" />

                            <Button
                                android:id="@+id/Graph"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginHorizontal="4dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/grey"
                                android:text="Graph"
                                android:textColor="@color/black"
                                android:textSize="10sp" />

                            <Button
                                android:id="@+id/addExpenseBtn"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/grey"
                                android:text="Expense"
                                android:textColor="@color/blue"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Filter buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <Button
                                android:id="@+id/fromDateButton"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:backgroundTint="#6F6B6B"
                                android:text="From"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />

                            <Button
                                android:id="@+id/toDateButton"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:backgroundTint="#757171"
                                android:text="To"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Search -->
                        <Button
                            android:id="@+id/search"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:layout_marginTop="6dp"
                            android:backgroundTint="@color/bright_orange"
                            android:text="Search"
                            android:textColor="@color/black"
                            android:textSize="10sp" />

                        <!-- RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerView"
                            android:layout_width="343dp"
                            android:layout_height="457dp"
                            android:layout_marginTop="8dp"
                            android:background="#2BF8FAFA"
                            android:padding="4dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/Add_Expense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add Expense" />
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:weightSum="3"
            android:background="@color/white"
            android:elevation="8dp"
            android:padding="12dp"
            android:backgroundTint="@color/blue"
            android:gravity="center_horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/GoalsNav"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Goal"
                android:textColor="@color/black"
                android:backgroundTint="@color/blue"
                app:icon="@drawable/goal"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/FinancialNav"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Finance"
                android:textColor="@color/black"
                android:backgroundTint="@color/blue"
                app:icon="@drawable/budget"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/DebtNav"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Category"
                android:textColor="@color/black"
                android:backgroundTint="@color/blue"
                app:icon="@drawable/money"
                app:iconGravity="textStart"
                app:iconPadding="4dp" />
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
