<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/goal">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background"
        tools:context=".GoalActivity">

        <!-- Scrollable content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingBottom="96dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="20dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/GoalText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Goals"
                            android:textAlignment="center"
                            android:textColor="@color/bright_orange"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:id="@+id/StreaksDays"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5 days"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:layout_marginEnd="8dp"/>

<!--                            <ImageView-->
<!--                                android:id="@+id/streaksimage"-->
<!--                                android:layout_width="20dp"-->
<!--                                android:layout_height="20dp"-->
<!--                                android:src="@drawable/streaks"-->
<!--                                android:contentDescription="Streak Icon"/>-->

                        </LinearLayout>

                        <!-- Timeframe Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <Button
                                android:id="@+id/WklyBtn"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:textSize="11sp"
                                android:backgroundTint="@color/grey"
                                android:text="Weekly"
                                android:textColor="@color/blue" />

                            <Button
                                android:id="@+id/MthlyBtn"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:textSize="10sp"
                                android:backgroundTint="@color/grey"
                                android:text="Monthly"
                                android:textColor="@color/black" />

                            <Button
                                android:id="@+id/YrlyBtn"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:textSize="13sp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:backgroundTint="@color/grey"
                                android:text="Yearly"
                                android:textColor="@color/black" />
                        </LinearLayout>

                        <!-- Goal Info and Badge -->
                        <TextView
                            android:id="@+id/goalAmountTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="24sp"
                            android:textColor="@color/black"
                            android:text="Weekly" />

                        <TextView
                            android:id="@+id/BadgeText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="You are a bronze saver! Keep up the good work!" />

<!--                        <ImageView-->
<!--                            android:id="@+id/badgeImageView"-->
<!--                            android:layout_width="120dp"-->
<!--                            android:layout_height="120dp"-->
<!--                            android:layout_gravity="center"-->
<!--                            android:contentDescription="User Badge"-->
<!--                            app:srcCompat="@drawable/badges_bronze" />-->

                        <!-- Weekly Progress Bar -->
                        <TextView
                            android:id="@+id/WeeklyPBText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:text="Weekly Goal Progress!" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="16dp"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/curWklAmtText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="16sp"
                                android:textColor="@android:color/black"
                                android:layout_marginEnd="8dp" />

                            <ProgressBar
                                android:id="@+id/WeeklyPB"
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="198dp"
                                android:layout_height="wrap_content"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="@color/bright_orange" />

                            <TextView
                                android:id="@+id/WklyGoalText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100"
                                android:textSize="16sp"
                                android:textColor="@android:color/black"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <!-- Progress to Next Badge -->
                        <TextView
                            android:id="@+id/textView4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:text="Progress till the next badge!" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/amtTwrdsGoal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:text="0"
                                android:textColor="@android:color/black"
                                android:textSize="16sp" />

                            <ProgressBar
                                android:id="@+id/TilNxtGoalPB"
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="196dp"
                                android:layout_height="wrap_content"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="@color/bright_orange" />

                            <TextView
                                android:id="@+id/NxtGoal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="100"
                                android:textColor="@android:color/black"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/AddGoalsBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:padding="8dp"
                            android:text="Would you like to set new goals? Click here."
                            android:textSize="14sp"
                            android:backgroundTint="@color/blue"
                            android:textColor="@color/white"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="1dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:weightSum="3"
            android:background="@color/white"
            android:elevation="8dp"
            android:padding="12dp"
            android:backgroundTint="@color/blue"
            android:gravity="center_horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/GoalsNav"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Goal"
                android:textColor="@color/black"
                android:backgroundTint="@color/blue"
                app:icon="@drawable/goal"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/FinancialNav"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Finance"
                android:textColor="@color/black"
                android:backgroundTint="@color/blue"
                app:icon="@drawable/budget"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/DebtNav"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Debt"
                android:textColor="@color/black"
                android:backgroundTint="@color/blue"
                app:icon="@drawable/money"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
