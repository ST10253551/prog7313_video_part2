<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addgoal"
    tools:context=".Add_GoalActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="20dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/goalsTitle"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Goals"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/bright_orange"
                android:layout_marginBottom="32dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please enter the amount you want to set your new goal and select what period of time you."
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                android:textColor="@android:color/black" />

            <EditText
                android:id="@+id/goalAmountInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Goal Amount"
                android:inputType="numberDecimal"
                android:backgroundTint="@color/grey"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/periodSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp" />


            <EditText
                android:id="@+id/planOfActionInput"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Plan of action!"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:backgroundTint="@color/grey"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/saveGoalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Goal Information"
                android:backgroundTint="@color/blue"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>