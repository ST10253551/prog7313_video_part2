<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/background"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:id="@+id/income"
    tools:content=".Add_IncomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:padding="24dp"
        android:elevation="8dp"
        android:layout_margin="8dp"
        android:backgroundTint="@android:color/white"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal">

        <TextView
            android:id="@+id/incomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Income"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/bright_orange"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please enter Income details."
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Income Name -->
        <EditText
            android:id="@+id/incomeNameInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Income Name"
            android:inputType="text"
            android:backgroundTint="@color/grey"
            android:layout_marginBottom="12dp" />

        <!-- Income Amount -->
        <EditText
            android:id="@+id/incomeAmountInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Income Amount"
            android:inputType="numberDecimal"
            android:backgroundTint="@color/grey"
            android:layout_marginBottom="12dp" />

        <!-- Date and Time -->
        <EditText
            android:id="@+id/incomeDateInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Select Date and Time"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:padding="10dp"
            android:textColor="#000000"
            android:textColorHint="#000000"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/grey" />

        <!-- Expense Image (ImageView) -->
        <ImageView
            android:id="@+id/ExpenseImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:layout_gravity="center" />

        <!-- Select Image Button -->
        <Button
            android:id="@+id/selectIncomeImageButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Image"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Save Income Button -->
        <Button
            android:id="@+id/saveIncomeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Income"
            android:backgroundTint="@android:color/black"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Back to Report Button -->
    <Button
        android:id="@+id/BackToReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Report" />
</LinearLayout>
